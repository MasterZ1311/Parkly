// ============================================================
// Parkly — Prisma Database Schema (PostgreSQL)
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Users ---
model User {
  id        String   @id @default(uuid())
  phone     String   @unique
  name      String
  email     String?  @unique
  role         UserRole  @default(driver)
  isActive     Boolean   @default(true)
  isAnonymized Boolean   @default(false) @map("is_anonymized")
  anonymizedAt DateTime? @map("anonymized_at")
  deletedAt    DateTime? @map("deleted_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  vehicles  Vehicle[]
  bookings  Booking[]
  host      Host?
  driverKyc DriverKyc?
  disputes  Dispute[]

  @@index([deletedAt])
  @@map("users")
}

enum UserRole {
  driver
  host
  admin
}

// --- Vehicles ---
model Vehicle {
  id           String      @id @default(uuid())
  userId       String      @map("user_id")
  licensePlate String      @unique @map("license_plate")
  vehicleType  VehicleType @map("vehicle_type")
  make               String?
  model              String?
  color              String?
  rcNumber           String?            @map("rc_number")
  rcDocumentUrl      String?            @map("rc_document_url")
  insuranceNumber    String?            @map("insurance_number")
  pucValidUntil      DateTime?          @map("puc_valid_until")
  verificationStatus VerificationStatus @default(pending) @map("verification_status")
  isDefault          Boolean            @default(false) @map("is_default")
  deletedAt    DateTime?   @map("deleted_at")
  createdAt    DateTime    @default(now()) @map("created_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@index([deletedAt])
  @@map("vehicles")
}

enum VehicleType {
  motorcycle
  compact
  sedan
  suv
  van
  truck
}

// --- Hosts ---
model Host {
  id                  String             @id @default(uuid())
  userId              String             @unique @map("user_id")
  businessName        String?            @map("business_name")
  panNumber           String?            @map("pan_number")
  bankAccountNumber   String?            @map("bank_account_number")
  ifscCode            String?            @map("ifsc_code")
  kycFullName         String?            @map("kyc_full_name")
  kycPhone            String?            @map("kyc_phone")
  govIdType           String?            @map("gov_id_type")
  govIdNumberMasked   String?            @map("gov_id_number_masked")
  govIdDocumentUrl    String?            @map("gov_id_document_url")
  ownershipProofType  String?            @map("ownership_proof_type")
  ownershipDocumentUrl String?           @map("ownership_document_url")
  addressProofUrl     String?            @map("address_proof_url")
  plotPhotoUrls       String[]           @default([]) @map("plot_photo_urls")
  upiId               String?            @map("upi_id")
  kycNotes            String?            @map("kyc_notes")
  verificationStatus  VerificationStatus @default(pending) @map("verification_status")
  reviewNotes         String?            @map("review_notes")
  reviewedBy          String?            @map("reviewed_by")
  submittedAt         DateTime?          @map("submitted_at")
  verifiedAt          DateTime?          @map("verified_at")
  totalEarnings       Decimal            @default(0) @map("total_earnings")
  totalPayouts        Decimal            @default(0) @map("total_payouts")
  isAnonymized        Boolean            @default(false) @map("is_anonymized")
  deletedAt           DateTime?          @map("deleted_at")
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  spaces        ParkingSpace[]
  bookings      Booking[]
  payouts       Payout[]

  @@index([deletedAt])
  @@map("hosts")
}

enum VerificationStatus {
  pending
  approved
  rejected
}

// --- Driver KYC & Document Verification ---
model DriverKyc {
  id                       String             @id @default(uuid())
  userId                   String             @unique @map("user_id")
  fullName                 String             @map("full_name")
  dateOfBirth              String?            @map("date_of_birth")
  address                  String?
  emergencyContact         String?            @map("emergency_contact")
  drivingLicenseNumber     String             @map("driving_license_number")
  drivingLicenseExpiry     String?            @map("driving_license_expiry")
  drivingLicenseFrontUrl   String             @map("driving_license_front_url")
  drivingLicenseBackUrl    String?            @map("driving_license_back_url")
  govIdType                String             @map("gov_id_type")
  govIdNumberMasked        String             @map("gov_id_number_masked")
  govIdDocumentUrl         String             @map("gov_id_document_url")
  vehicleId                String?            @map("vehicle_id")
  vehiclePlate             String             @map("vehicle_plate")
  rcNumber                 String             @map("rc_number")
  rcDocumentUrl            String             @map("rc_document_url")
  insuranceDocumentUrl     String?            @map("insurance_document_url")
  selfieUrl                String?            @map("selfie_url")
  status                   VerificationStatus @default(pending)
  reviewNotes              String?            @map("review_notes")
  reviewedBy               String?            @map("reviewed_by")
  reviewedAt               DateTime?          @map("reviewed_at")
  submittedAt              DateTime           @default(now()) @map("submitted_at")
  updatedAt                DateTime           @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([drivingLicenseNumber])
  @@map("driver_kycs")
}

// --- Parking Spaces ---
model ParkingSpace {
  id             String       @id @default(uuid())
  hostId         String       @map("host_id")
  name           String
  description    String?
  latitude       Decimal      @db.Decimal(10, 7)
  longitude      Decimal      @db.Decimal(10, 7)
  geohash        String       // pre-computed geohash for spatial queries
  address        String
  city           String
  state          String
  pincode        String
  regionId       String       @map("region_id")
  totalCapacity     Int           @map("total_capacity")
  vehicleTypes      VehicleType[]
  spaceType         SpaceType     @default(commercial) @map("space_type")
  entryInstructions String?       @map("entry_instructions")
  evCharging        Boolean       @default(false) @map("ev_charging")
  covered           Boolean       @default(false)
  securityLevel     SecurityLevel @default(none) @map("security_level")
  accessibility     String[]      // array of AccessibilityFeature values
  cctv              Boolean       @default(false)
  lighting          Boolean       @default(false)
  attendant         Boolean       @default(false)
  hourlyRate        Decimal       @map("hourly_rate") @db.Decimal(10, 2)
  currency          String        @default("INR")
  dynamicPricing    Boolean       @default(false) @map("dynamic_pricing")
  minBookingHours   Int           @default(1) @map("min_booking_hours")
  maxBookingHours   Int           @default(24) @map("max_booking_hours")
  photoUrls         String[]      @map("photo_urls")
  ownershipProofUrl String?       @map("ownership_proof_url")
  reviewNotes       String?       @map("review_notes")
  verifiedAt        DateTime?     @map("verified_at")
  status            SpaceStatus   @default(draft)
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  host              Host           @relation(fields: [hostId], references: [id])
  region            Region         @relation(fields: [regionId], references: [id], onDelete: Restrict)
  availabilitySlots AvailabilitySlot[]
  bookings          Booking[]
  pricingRules      PricingRule[]

  @@index([geohash])
  @@index([city])
  @@index([status])
  @@index([spaceType])
  @@index([regionId])
  @@map("parking_spaces")
}

enum SpaceType {
  commercial
  private_house
  apartment_bay
  gated_compound
}

enum SpaceStatus {
  draft
  pending_verification
  active
  inactive
  suspended
}

enum SecurityLevel {
  none
  basic
  monitored
  staffed
  gated
}

// --- Availability Slots ---
model AvailabilitySlot {
  id         String  @id @default(uuid())
  spaceId    String  @map("space_id")
  dayOfWeek  Int     @map("day_of_week")  // 0-6
  startTime  String  @map("start_time")  // HH:mm
  endTime    String  @map("end_time")    // HH:mm

  space ParkingSpace @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@map("availability_slots")
}

// --- Bookings ---
model Booking {
  id                 String        @id @default(uuid())
  userId             String        @map("user_id")
  spaceId            String        @map("space_id")
  vehicleId          String        @map("vehicle_id")
  hostId             String        @map("host_id")
  type               BookingType
  status             BookingStatus @default(created)
  startTime          DateTime      @map("start_time")
  endTime            DateTime      @map("end_time")
  durationMinutes    Int           @map("duration_minutes")
  recurringFrequency String?       @map("recurring_frequency")
  recurringEndDate   DateTime?     @map("recurring_end_date")
  totalAmount        Decimal       @map("total_amount") @db.Decimal(10, 2)
  currency           String        @default("INR")
  paymentId          String?       @map("payment_id")
  gateCode           String?       @map("gate_code")
  checkedInAt        DateTime?     @map("checked_in_at")
  checkedOutAt       DateTime?     @map("checked_out_at")
  leavingNotifiedAt  DateTime?     @map("leaving_notified_at")
  overstayMinutes    Int           @default(0) @map("overstay_minutes")
  overstayAmount     Decimal       @default(0) @map("overstay_amount") @db.Decimal(10, 2)
  cancellationReason String?       @map("cancellation_reason")
  cancelledAt        DateTime?     @map("cancelled_at")
  completedAt        DateTime?     @map("completed_at")
  deletedAt          DateTime?     @map("deleted_at")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  user    User         @relation(fields: [userId], references: [id])
  space   ParkingSpace @relation(fields: [spaceId], references: [id])
  vehicle Vehicle      @relation(fields: [vehicleId], references: [id])
  host    Host         @relation(fields: [hostId], references: [id], onDelete: Restrict)
  payment Payment?
  dispute Dispute?

  @@index([userId])
  @@index([spaceId])
  @@index([hostId])
  @@index([status])
  @@index([startTime, endTime])
  @@index([deletedAt])
  @@map("bookings")
}


enum BookingType {
  instant
  scheduled
  recurring
}

enum BookingStatus {
  created
  confirmed
  active
  completed
  cancelled
  refunded
}

// --- Payments ---
model Payment {
  id                String        @id @default(uuid())
  bookingId         String        @unique @map("booking_id")
  userId            String        @map("user_id")
  amount            Decimal       @db.Decimal(10, 2)
  currency          String        @default("INR")
  provider          String
  providerPaymentId String?       @map("provider_payment_id")
  providerOrderId   String?       @map("provider_order_id")
  tokenRef          String?       @map("token_ref")  // tokenized ref only, never raw payment data
  status            PaymentStatus @default(pending)
  failureReason     String?       @map("failure_reason")
  refundAmount      Decimal?      @map("refund_amount") @db.Decimal(10, 2)
  refundId          String?       @map("refund_id")
  refundedAt        DateTime?     @map("refunded_at")
  payoutId          String?       @map("payout_id")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  booking Booking @relation(fields: [bookingId], references: [id])
  payout  Payout? @relation(fields: [payoutId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@index([payoutId])
  @@map("payments")
}

enum PaymentStatus {
  pending
  completed
  failed
  refunded
}

// --- Payouts ---
model Payout {
  id                 String       @id @default(uuid())
  hostId             String       @map("host_id")
  amount             Decimal      @db.Decimal(10, 2)
  platformCommission Decimal      @map("platform_commission") @db.Decimal(10, 2)
  currency           String       @default("INR")
  status             PayoutStatus @default(pending)
  paymentIds         String[]     @map("payment_ids")
  processedAt        DateTime?    @map("processed_at")
  createdAt          DateTime     @default(now()) @map("created_at")

  host     Host      @relation(fields: [hostId], references: [id])
  payments Payment[]

  @@index([hostId])
  @@map("payouts")
}

enum PayoutStatus {
  pending
  processing
  completed
  failed
}

// --- Pricing Rules ---
model PricingRule {
  id         String   @id @default(uuid())
  spaceId    String?  @map("space_id")  // null = global
  name       String
  multiplier Decimal  @db.Decimal(5, 2)
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")

  space ParkingSpace? @relation(fields: [spaceId], references: [id])

  @@map("pricing_rules")
}

// --- Disputes ---
model Dispute {
  id          String        @id @default(uuid())
  bookingId   String        @unique @map("booking_id")
  raisedBy    String        @map("raised_by")
  disputeType DisputeType   @map("dispute_type")
  description String
  status      DisputeStatus @default(open)
  resolution  String?
  resolvedBy  String?       @map("resolved_by")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  booking Booking @relation(fields: [bookingId], references: [id])
  user    User    @relation(fields: [raisedBy], references: [id])

  @@map("disputes")
}

enum DisputeType {
  no_show
  unauthorized_use
  payment_dispute
  other
}

enum DisputeStatus {
  open
  under_review
  resolved
  closed
}

// --- Regions ---
model Region {
  id               String   @id
  name             String
  country          String
  state            String
  city             String
  boundsNorth      Decimal  @map("bounds_north") @db.Decimal(10, 7)
  boundsSouth      Decimal  @map("bounds_south") @db.Decimal(10, 7)
  boundsEast       Decimal  @map("bounds_east") @db.Decimal(10, 7)
  boundsWest       Decimal  @map("bounds_west") @db.Decimal(10, 7)
  geohashPrefixes  String[] @map("geohash_prefixes")
  adjacentRegions  String[] @map("adjacent_regions")
  isActive         Boolean  @default(true) @map("is_active")

  spaces ParkingSpace[]

  @@map("regions")
}

// --- Audit Logs ---
model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?  @map("actor_id")
  actorName String   @map("actor_name")
  action    String
  target    String
  ipAddress String?  @map("ip_address")
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([action])
  @@map("audit_logs")
}

// --- System Alerts ---
model SystemAlert {
  id         String       @id @default(uuid())
  severity   String       // critical | warning | info
  title      String
  detail     String
  source     String       @default("system")
  resolved   Boolean      @default(false)
  resolvedBy String?      @map("resolved_by")
  resolvedAt DateTime?    @map("resolved_at")
  createdAt  DateTime     @default(now()) @map("created_at")

  @@index([resolved, createdAt])
  @@map("system_alerts")
}

// --- Platform Settings ---
model PlatformSetting {
  key       String   @id
  value     String
  updatedBy String?  @map("updated_by")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("platform_settings")
}
