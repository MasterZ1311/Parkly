{
  "expo": {
    "name": "Parkly",
    "slug": "parkly",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F6F2"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "updates": {
      "enabled": false
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.zeustechnologies.parkly",
      "infoPlist": {
        "CADisableMinimumFrameDurationOnPhone": true,
        "NSLocationWhenInUseUsageDescription": "Parkly needs your location to find nearby parking spaces.",
        "NSLocationAlwaysUsageDescription": "Parkly uses your location to find parking near you."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.zeustechnologies.parkly",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-location",
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Allow Parkly to use Face ID for secure login."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#D90410",
          "defaultChannel": "parkly_default"
        }
      ],
      "@maplibre/maplibre-react-native"
    ],
    "scheme": "parkly"
  }
}
